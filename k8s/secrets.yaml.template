# DO NOT APPLY THIS TEMPLATE DIRECTLY TO PRODUCTION!
# Copy to secrets.yaml and populate with real encrypted/base64 secrets,
# or manage via SealedSecrets / External Secrets Operator.
apiVersion: v1
kind: Secret
metadata:
  name: travelbrain-secrets
  namespace: travelbrain
type: Opaque
stringData:
  REDIS_PASSWORD: "CHANGE_ME_REDIS_STRONG_PASSWORD"
  POSTGRES_PASSWORD: "CHANGE_ME_POSTGRES_STRONG_PASSWORD"
  JWT_PRIVATE_KEY_PEM: |
    -----BEGIN PRIVATE KEY-----
    CHANGE_ME_RSA_PRIVATE_KEY_PEM
    -----END PRIVATE KEY-----
  GOOGLE_CLIENT_ID: "CHANGE_ME_GOOGLE_CLIENT_ID"
  GOOGLE_CLIENT_SECRET: "CHANGE_ME_GOOGLE_CLIENT_SECRET"
  AVIATIONSTACK_API_KEY: "CHANGE_ME_AVIATIONSTACK_KEY"
  TAVILY_API_KEY: "CHANGE_ME_TAVILY_KEY"
  OPENWEATHER_API_KEY: "CHANGE_ME_OPENWEATHER_KEY"
  GROQ_API_KEY: "CHANGE_ME_GROQ_KEY"
  GEMINI_API_KEY: "CHANGE_ME_GEMINI_KEY"
